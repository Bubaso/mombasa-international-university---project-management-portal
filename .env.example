# Copy this file to .env.local and fill in the values.
# Everything prefixed with VITE_ is embedded in the browser bundle at build
# time, so only ever put PUBLIC values here.

# --- Supabase -------------------------------------------------------------
# Project URL and anon key from the Supabase dashboard (Project Settings > API).
# The anon key is public by design; every table it can reach MUST be protected
# by row level security. Without RLS this key grants full read/write access.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# --- AI assistant ---------------------------------------------------------
# The Gemini key is NOT listed here on purpose. It must never reach the
# browser. It belongs in the server-side function that proxies AI calls
# (see supabase/functions/ai-assistant), configured as a secret there.
# This variable only points the client at that function.
VITE_AI_PROXY_URL=""
