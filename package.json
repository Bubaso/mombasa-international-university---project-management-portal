{
  "name": "miu-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "npm run build:smoke && node tests/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:smoke && npm run test:policies && npm run test:assistant && npm run test:translate && npm run test:exports && npm run test:push && npm run test:push:sw && npm run test:nav && npm run test:palette && npm run test:intake && npm run test:sql-objects && npm run test:enum-drift && npm run test:register-states && npm run test:list-reads && npm run test:populated && npm run test:doc-counts && npm run test:screen-text",
    "test:policies": "bash tests/db/run.sh",
    "test:assistant": "node tests/assistant.mjs",
    "sql:bundle": "node scripts/bundle-migrations.mjs",
    "build:smoke": "VITE_SUPABASE_URL=https://smoke.supabase.co VITE_SUPABASE_ANON_KEY=smoke-anon-key VITE_AI_PROXY_URL=https://smoke.functions.test/ai-assistant vite build --outDir dist-smoke",
    "import:notion": "node scripts/import-notion.mjs",
    "test:translate": "node tests/translate.mjs",
    "test:exports": "node tests/exports.mjs",
    "test:push": "node tests/push.mjs",
    "test:push:sw": "npm run build && node tests/push-sw.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:nav": "node tests/nav.mjs",
    "test:palette": "node tests/palette.mjs",
    "test:intake": "node tests/intake.mjs",
    "test:sql-objects": "node tests/sql-objects.mjs",
    "test:enum-drift": "node tests/enum-drift.mjs",
    "test:register-states": "node tests/register-states.mjs",
    "test:list-reads": "node tests/list-reads.mjs",
    "test:populated": "npm run build:smoke && node tests/populated.mjs",
    "test:doc-counts": "node tests/doc-counts.mjs",
    "test:screen-text": "node tests/screen-text.mjs",
    "test:design": "node tests/design.mjs",
    "deploy": "npm run build && npm run check:dist && firebase deploy --only hosting --project miu-kenya"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
